{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pedagogical Script Draft Contract (v4.4 Master Science Teacher Mode)",
  "type": "object",
  "required": [
    "schema_version",
    "teaching_profile",
    "learning_objective",
    "prerequisite_knowledge",
    "core_question",
    "analogy",
    "concept_steps",
    "key_terms",
    "understanding_check"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["4.4", "4.4.0"]
    },
    "repo_name": {
      "type": "string",
      "minLength": 1
    },
    "teaching_profile": {
      "type": "object",
      "required": [
        "target_audience",
        "teacher_persona",
        "target_speaking_rate_cpm",
        "six_step_pedagogy"
      ],
      "properties": {
        "target_audience": {
          "type": "string",
          "enum": ["zero_programming_beginner"]
        },
        "teacher_persona": {
          "type": "string",
          "enum": ["master_science_teacher"]
        },
        "target_speaking_rate_cpm": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 150,
            "maximum": 260
          }
        },
        "six_step_pedagogy": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string",
            "enum": [
              "problem",
              "analogy",
              "concept",
              "mechanism",
              "application",
              "transfer"
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "learning_objective": {
      "type": "string",
      "minLength": 8
    },
    "prerequisite_knowledge": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "core_question": {
      "type": "string",
      "minLength": 8
    },
    "analogy": {
      "type": "object",
      "required": [
        "everyday_analogy",
        "mapping",
        "boundary"
      ],
      "properties": {
        "everyday_analogy": {
          "type": "string",
          "minLength": 8
        },
        "mapping": {
          "type": "string",
          "minLength": 8
        },
        "boundary": {
          "type": "string",
          "minLength": 8
        }
      },
      "additionalProperties": false
    },
    "concept_steps": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "step_number",
          "pedagogical_stage",
          "title",
          "narration",
          "estimated_duration_seconds",
          "plain_explanation"
        ],
        "properties": {
          "step_number": {
            "type": "integer",
            "minimum": 1
          },
          "pedagogical_stage": {
            "type": "string",
            "enum": [
              "problem",
              "analogy",
              "concept",
              "mechanism",
              "application",
              "transfer"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 2
          },
          "narration": {
            "type": "string",
            "minLength": 15
          },
          "estimated_duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "plain_explanation": {
            "type": "string",
            "minLength": 6
          },
          "input_state": {
            "type": "string",
            "minLength": 2
          },
          "process_detail": {
            "type": "string",
            "minLength": 4
          },
          "why_designed_this_way": {
            "type": "string",
            "minLength": 4
          },
          "output_state": {
            "type": "string",
            "minLength": 2
          },
          "authentic_code_reference": {
            "type": "string",
            "minLength": 2
          }
        },
        "additionalProperties": true
      }
    },
    "key_terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "term",
          "plain_first_explanation",
          "full_expansion",
          "explained_before_jargon"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "plain_first_explanation": {
            "type": "string",
            "minLength": 6
          },
          "full_expansion": {
            "type": "string",
            "minLength": 2
          },
          "explained_before_jargon": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "understanding_check": {
      "type": "object",
      "required": [
        "questions",
        "takeaway",
        "transfer_scenarios"
      ],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["question", "expected_answer"],
            "properties": {
              "question": {"type": "string", "minLength": 4},
              "expected_answer": {"type": "string", "minLength": 4}
            },
            "additionalProperties": false
          }
        },
        "takeaway": {
          "type": "string",
          "minLength": 6
        },
        "transfer_scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 4
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
