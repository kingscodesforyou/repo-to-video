{
  "name": "remotionagent",
  "version": "4.0.0",
  "description": "repo-to-video v4 Visual Director & Choreographed Motion Engine",
  "main": "src/index.ts",
  "scripts": {
    "dev": "remotion preview src/index.ts",
    "preview": "remotion preview src/index.ts",
    "render": "remotion render src/index.ts TutorialVideo out/video.mp4",
    "render:props": "remotion render src/index.ts TutorialVideo out/video.mp4 --props=workspace/build_props.json",
    "render:first-shot": "remotion render src/index.ts FirstShotVideo out/first_shot.mp4 --props=workspace/build_props.first_shot.json",
    "render:pilot": "remotion render src/index.ts PilotVideo out/pilot.mp4 --props=workspace/build_props.pilot.json",
    "still": "remotion still src/index.ts TutorialVideo out/cover.png --frame=60",
    "still:first-shot": "remotion still src/index.ts FirstShotVideo out/first_shot_preview.png --frame=45",
    "still:pilot": "remotion still src/index.ts PilotVideo out/pilot_preview.png --frame=45"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@remotion/cli": "^4.0.540",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.540",
    "typescript": "^7.0.2"
  }
}
