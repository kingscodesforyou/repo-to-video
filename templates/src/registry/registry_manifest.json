{
  "registry_version": "4.4.0",
  "supported_visual_modes": {
    "2d_editorial": {
      "description": "正视平面教学构图：文字与图表严格水平、零三维倾斜、零透视形变，支持平面平移、缩放、遮罩揭示与元素重组",
      "allow_3d_tilt": false,
      "allow_perspective": false,
      "forbidden_cameras": [
        "orbit_left",
        "orbit_right",
        "isometric_tilt",
        "top_down_overview"
      ]
    },
    "3d_spatial": {
      "description": "三维空间教学构图：仅在机械结构、物理运动、粒子分流、三维拓扑网络、立体结构拆解与形态变化提供明确教学价值时使用",
      "allow_3d_tilt": true,
      "allow_perspective": true,
      "forbidden_cameras": []
    },
    "hybrid": {
      "description": "混合教学构图：3D 空间主体（机械/粒子/拓扑）+ 2D 正视信息层（正交水平标签、指标与原理解释，绝不随 3D 主体倾斜）",
      "allow_3d_tilt": true,
      "allow_perspective": true,
      "orthogonal_2d_overlay": true,
      "forbidden_cameras": []
    }
  },
  "element_budget_policy": {
    "max_total_major_elements": 4,
    "max_primary_objects": 1,
    "max_secondary_objects": 3,
    "max_text_overlays": 2,
    "collective_groups": [
      "information_particles",
      "signal_particles",
      "network_nodes",
      "data_packets",
      "request_packets"
    ]
  },
  "supported_environments": {
    "minimal_physical_laboratory": {
      "theme_default": "dark_cinematic",
      "grid_size": 64,
      "horizon_line": true,
      "floor_reflection": 0.18,
      "perspective_px": 1800,
      "description": "极简物理实验室：带光学水平基准线、体积地面反射与精密标尺网格"
    },
    "dark_architectural_stage": {
